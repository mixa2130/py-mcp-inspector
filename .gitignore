# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node (the jsdom UI tests under tests/ui)
node_modules/
package-lock.json

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Secrets and local state.
# Saved presets hold bearer tokens and key passphrases in plain text; the
# default location is ~/.pymcpinspector/servers.json, but --config can point
# anywhere, including here.
.env
.pymcpinspector/
servers.json

# Certificates and private keys. The TLS fields take paths, so keys have no
# reason to live in the repository -- the test suite mints its own throwaway
# CA in a temporary directory.
*.pem
*.key
*.crt
*.cer
*.csr
*.srl
*.p12
*.pfx
